# MongoDB connection string — get this from MongoDB Atlas dashboard.
# Include the database name explicitly (e.g. .../jeevanmitra?retryWrites=true&w=majority)
# so it's unambiguous which database the app writes to.
MONGODB_URI=your_mongodb_connection_string_here

# Any long random string — used to sign/verify all JWT tokens
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000

# Admin login credentials (used by /api/auth/admin/login)
ADMIN_EMAIL=admin@jeevanmitra.in
ADMIN_PASSWORD=change_this_password

NODE_ENV=development
