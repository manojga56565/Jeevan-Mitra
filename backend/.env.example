# MongoDB connection string — get this from MongoDB Atlas dashboard
MONGODB_URI=your_mongodb_connection_string_here

# Any long random string — used to sign/verify all JWT tokens
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000

# Admin login credentials (used by /api/auth/admin/login)
ADMIN_EMAIL=admin@jeevanmitra.in
ADMIN_PASSWORD=change_this_password

# SMS OTP provider — NOT currently wired in (mock OTP is used instead, see
# services/authService.js). Fill these in later if you want real SMS.
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

NODE_ENV=development
